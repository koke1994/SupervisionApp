                  font-size: 11px; font-weight: bold; display: inline-block; margin-left: 8px; }
    .firma-box { border-top: 1.5px solid #2C3E50; margin-top: 8px; padding-top: 4px;
                 text-align: center; font-size: 11px; color: #7F8C8D; }
