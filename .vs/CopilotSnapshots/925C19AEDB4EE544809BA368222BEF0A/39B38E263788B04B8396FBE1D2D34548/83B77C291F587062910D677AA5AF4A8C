//  localDB.js  —  BÓVEDA OFFLINE (SQLite)
//  Guarda todo localmente. La app funciona sin internet.
//  Firebase y Google Drive son capas opcionales encima.
// ═══════════════════════════════════════════════════════════════════════════════
import * as SQLite from 'expo-sqlite';

let db = null;

// Inicializar DB de forma async (expo-sqlite v16+)
async function getDatabase() {
  if (!db) {
    db = await SQLite.openDatabaseAsync('supervision_gcc.db');
  }
  return db;
}

// ── Inicializar tablas ────────────────────────────────────────────────────────
export async function initDatabase() {
  try {
    const database = await getDatabase();

    // Tabla principal: supervisiones
    await database.execAsync(`
      CREATE TABLE IF NOT EXISTS supervisiones (
        id          TEXT PRIMARY KEY,
        lider       TEXT,
        gestor      TEXT,
        gerencia    TEXT,
        fecha       TEXT,
        semana      TEXT,
        alcance     REAL,
        cobrado     REAL,
        tareas      INTEGER,
        tipo_visita TEXT,
        clasificacion_gic TEXT,
        data_json   TEXT,
        creado_en   TEXT,
        sincronizado INTEGER DEFAULT 0
      );
    `);

    // Tabla: cola de emails pendientes
    await database.execAsync(`
      CREATE TABLE IF NOT EXISTS email_queue (
        id            INTEGER PRIMARY KEY AUTOINCREMENT,
        supervision_id TEXT,
        lider         TEXT,
        gestor        TEXT,
        fecha         TEXT,
        pdf_base64    TEXT,
        intentos      INTEGER DEFAULT 0,
        ultimo_intento TEXT,
        estado        TEXT DEFAULT 'pendiente',
        es_reintento  INTEGER DEFAULT 0,
        creado_en     TEXT
      );
    `);

    // Tabla: historial acumulado por gestor
    await database.execAsync(`
      CREATE TABLE IF NOT EXISTS historial_gestor (
        id            INTEGER PRIMARY KEY AUTOINCREMENT,
        gestor        TEXT,
        gerencia      TEXT,
        semana        TEXT,
        fecha         TEXT,
        alcance       REAL,
        cobrado       REAL,
        tareas        INTEGER,
        pasos_promedio REAL,
        observaciones TEXT,
        compromisos   TEXT,
        clasificacion_gic TEXT,
        supervision_id TEXT,
        drive_file_id TEXT
      );
    `);

    // Tabla: configuración de Google Drive tokens
    await database.execAsync(`
      CREATE TABLE IF NOT EXISTS google_tokens (
        id            INTEGER PRIMARY KEY,
        access_token  TEXT,
        refresh_token TEXT,
        expires_at    TEXT,
        root_folder_id TEXT
      );
    `);

    return true;
  } catch (error) {
    console.warn('Error inicializando DB:', error);
    throw error;
  }
}

// ── SUPERVISIONES ─────────────────────────────────────────────────────────────
export async function guardarSupervisionLocal(formData) {
  try {
    const database = await getDatabase();
    const id = formData.id || `sup_${Date.now()}`;
    const ahora = new Date().toISOString();

    await database.runAsync(
      `INSERT OR REPLACE INTO supervisiones
         (id, lider, gestor, gerencia, fecha, semana, alcance, cobrado, tareas,
          tipo_visita, clasificacion_gic, data_json, creado_en, sincronizado)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0)`,
      [
        id,
        formData.lider || '',
        formData.gestor || '',
        formData.gerencia || '',
        formData.fecha || '',
        formData.semana || '',
        parseFloat(formData.alcance) || 0,
        parseFloat(formData.cobrado) || 0,
        parseInt(formData.tareasRealizadas) || 0,
        formData.tipoVisita || '',
        formData.clasificacionGIC || '',
        JSON.stringify(formData),
        ahora,
      ]
    );

    return id;
  } catch (error) {
    console.warn('Error guardando supervisión local:', error);
    throw error;
  }
}

export async function obtenerSupervisionesPorLider(lider) {
  try {
    const database = await getDatabase();
    const result = await database.allAsync(
      `SELECT * FROM supervisiones WHERE lider = ? ORDER BY creado_en DESC LIMIT 50`,
      [lider]
    );
    return result || [];
  } catch (error) {
    console.warn('Error obteniendo supervisiones por líder:', error);
    throw error;
  }
}

export async function obtenerSupervisionPorId(id) {
  try {
    const database = await getDatabase();
    const result = await database.getFirstAsync(
      `SELECT * FROM supervisiones WHERE id = ?`,
      [id]
    );

    if (result) {
      return JSON.parse(result.data_json);
    }
    return null;
  } catch (error) {
    console.warn('Error obteniendo supervisión por ID:', error);
    throw error;
  }
}

// ── EMAIL QUEUE ───────────────────────────────────────────────────────────────
export async function encolarEmail({ supervisionId, lider, gestor, fecha, pdfBase64, esReintento = false }) {
  try {
    const database = await getDatabase();
    await database.runAsync(
      `INSERT INTO email_queue
         (supervision_id, lider, gestor, fecha, pdf_base64, intentos, estado, es_reintento, creado_en)
        VALUES (?, ?, ?, ?, ?, 0, 'pendiente', ?, ?)`,
      [
        supervisionId,
        lider,
        gestor,
        fecha,
        pdfBase64,
        esReintento ? 1 : 0,
        new Date().toISOString(),
      ]
    );
    return true;
  } catch (error) {
    console.warn('Error encolando email:', error);
    throw error;
  }
}

export async function obtenerEmailsPendientes() {
  try {
    const database = await getDatabase();
    const result = await database.allAsync(
      `SELECT * FROM email_queue WHERE estado = 'pendiente' ORDER BY creado_en ASC`,
      []
    );
    return result || [];
  } catch (error) {
    console.warn('Error obteniendo emails pendientes:', error);
    throw error;
  }
}

export async function actualizarEstadoEmail(id, estado, intentos) {
  try {
    const database = await getDatabase();
    await database.runAsync(
      `UPDATE email_queue SET estado = ?, intentos = ?, ultimo_intento = ? WHERE id = ?`,
      [estado, intentos, new Date().toISOString(), id]
    );
    return true;
  } catch (error) {
    console.warn('Error actualizando estado de email:', error);
    throw error;
  }
}

// ── HISTORIAL GESTOR ──────────────────────────────────────────────────────────
export function guardarHistorialGestor(datos) {
  return new Promise((resolve, reject) => {
    db.transaction(
      (tx) => {
        tx.executeSql(
          `INSERT INTO historial_gestor
            (gestor, gerencia, semana, fecha, alcance, cobrado, tareas, pasos_promedio,
             observaciones, compromisos, clasificacion_gic, supervision_id)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
          [
            datos.gestor,
            datos.gerencia,
            datos.semana,
            datos.fecha,
            datos.alcance,
            datos.cobrado,
            datos.tareas,
            datos.pasosPromedio,
            datos.observaciones,
            datos.compromisos,
            datos.clasificacionGIC,
            datos.supervisionId,
          ]
        );
      },
      (error) => reject(error),
      () => resolve(true)
    );
  });
}

export function obtenerHistorialGestor(gestor) {
  return new Promise((resolve, reject) => {
    db.transaction((tx) => {
      tx.executeSql(
        `SELECT * FROM historial_gestor WHERE gestor = ? ORDER BY fecha DESC`,
        [gestor],
        (_, { rows }) => resolve(rows._array),
        (_, error) => reject(error)
      );
    });
  });
}

export function obtenerTodosGestores() {
  return new Promise((resolve, reject) => {
    db.transaction((tx) => {
      tx.executeSql(
        `SELECT DISTINCT gestor, gerencia, MAX(fecha) as ultima_sesion,
                COUNT(*) as total_sesiones, AVG(alcance) as promedio_alcance
         FROM historial_gestor GROUP BY gestor ORDER BY ultima_sesion DESC`,
        [],
        (_, { rows }) => resolve(rows._array),
        (_, error) => reject(error)
      );
    });
  });
}

// ── GOOGLE TOKENS ─────────────────────────────────────────────────────────────
export function guardarGoogleToken(accessToken, refreshToken, expiresIn, rootFolderId = null) {
  const expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();
  return new Promise((resolve, reject) => {
    db.transaction(
      (tx) => {
        tx.executeSql(
          `INSERT OR REPLACE INTO google_tokens (id, access_token, refresh_token, expires_at, root_folder_id)
           VALUES (1, ?, ?, ?, ?)`,
          [accessToken, refreshToken, expiresAt, rootFolderId]
        );
      },
      (error) => reject(error),
      () => resolve(true)
    );
  });
}

export function actualizarRootFolder(folderId) {
  return new Promise((resolve, reject) => {
    db.transaction(
      (tx) => {
        tx.executeSql(`UPDATE google_tokens SET root_folder_id = ? WHERE id = 1`, [folderId]);
      },
      (error) => reject(error),
      () => resolve(true)
    );
  });
}

export function obtenerGoogleToken() {
  return new Promise((resolve, reject) => {
    db.transaction((tx) => {
      tx.executeSql(
        `SELECT * FROM google_tokens WHERE id = 1`,
        [],
        (_, { rows }) => {
          if (rows.length > 0) {
            const row = rows._array[0];
            const isExpired = new Date(row.expires_at) <= new Date();
            resolve({ ...row, isExpired });
          } else {
            resolve(null);
          }
        },
        (_, error) => reject(error)
      );
    });
  });
}

export default db;
